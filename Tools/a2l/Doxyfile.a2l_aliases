# A2L annotation tags (see Tools/a2l/a2l_extract.py). Include from the project
# Doxyfile with: @INCLUDE = Tools/a2l/Doxyfile.a2l_aliases
ALIASES += a2l_measurement="\par A2L:^^MEASUREMENT"
ALIASES += a2l_characteristic="\par A2L:^^CHARACTERISTIC"
ALIASES += a2l_name{1}="\par A2L name:^^\1"
ALIASES += a2l_unit{1}="\par Unit:^^\1"
ALIASES += a2l_conversion{1}="\par Conversion (phys = a * raw + b):^^\1"
ALIASES += a2l_format{1}="\par Format:^^\1"
ALIASES += a2l_limits{1}="\par Limits:^^\1"
ALIASES += a2l_enum{1}="\par Values:^^\1"
ALIASES += a2l_rat_func{1}="\par Conversion (RAT_FUNC, phys -> raw coefficients a..f):^^\1"
ALIASES += a2l_formula{1}="\par Conversion (formula, X1 = raw):^^\1"
ALIASES += a2l_tab_intp{1}="\par Conversion table (interpolated, raw=phys):^^\1"
ALIASES += a2l_tab_nointp{1}="\par Conversion table (raw=phys):^^\1"
ALIASES += a2l_compu_ref{1}="\par Conversion:^^\1"
ALIASES += a2l_compu_method{1}="\par A2L compu method:^^\1"
ALIASES += a2l_axis_pts="\par A2L:^^AXIS_PTS"
ALIASES += a2l_input{1}="\par Axis input:^^\1"
ALIASES += a2l_axis_x{1}="\par X axis:^^\1"
ALIASES += a2l_axis_y{1}="\par Y axis:^^\1"
ALIASES += a2l_axis_z{1}="\par Z axis:^^\1"
ALIASES += a2l_project{1}="\par A2L project:^^\1"
ALIASES += a2l_module{1}="\par A2L module:^^\1"
