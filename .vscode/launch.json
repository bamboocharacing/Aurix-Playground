{
    "configurations": [
        {
            "name": "Debug with OpenOCD",
            "type": "cortex-debug",
            "cwd": "${workspaceRoot}",
            "executable": "bin/target.elf",
            "gdbPath": "C:/Users/max.holder/source/repos/AURIX/tricore-gcc-13.4.1-win32/bin/tricore-elf-gdb.exe",
            "servertype": "external",
            "gdbTarget": "localhost:3333",
            "request": "attach",
        },
        {
            "name": "tricore-qemu-debug",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/target.elf",
            "stopAtEntry": true,
            "cwd": "${workspaceRoot}",
            "MIMode": "gdb",
            "miDebuggerPath": "C:/Users/max.holder/source/repos/AURIX/tricore-gcc-13.4.1-win32/bin/tricore-elf-gdb.exe",
            "miDebuggerServerAddress": "localhost:1234",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set architecture TriCore:V1_6_2",
                    "ignoreFailures": false
                }
            ]
        }
    ],
}